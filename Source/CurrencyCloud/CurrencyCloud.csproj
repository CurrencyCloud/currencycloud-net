<Project Sdk="Microsoft.NET.Sdk">

    <!-- ============================================ -->
    <!-- Target Frameworks                            -->
    <!-- ============================================ -->
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- Assembly Identity                            -->
    <!-- ============================================ -->
    <PropertyGroup>
        <AssemblyName>CurrencyCloud</AssemblyName>
        <RootNamespace>CurrencyCloud</RootNamespace>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- Version Information                          -->
    <!-- ============================================ -->
    <PropertyGroup>
        <Version>10.0.0</Version>
        <AssemblyVersion>10.0.0.0</AssemblyVersion>
        <FileVersion>10.0.0.0</FileVersion>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- Package Metadata                             -->
    <!-- ============================================ -->
    <PropertyGroup>
        <PackageId>CurrencyCloud</PackageId>
        <Title>Currencycloud Client Library</Title>
        <Authors>Currencycloud</Authors>
        <Company>Currencycloud</Company>
        <Product>Currencycloud SDK</Product>
        <Description>The client library which implements Currencycloud's APIs.</Description>
        <Copyright>Copyright © Currencycloud 2015-2026</Copyright>
        <PackageTags>currencycloud;api;client;payments;forex;currency;net8;netstandard</PackageTags>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- Repository & License Information             -->
    <!-- ============================================ -->
    <PropertyGroup>
        <PackageProjectUrl>https://github.com/CurrencyCloud/currencycloud-net</PackageProjectUrl>
        <RepositoryUrl>https://github.com/CurrencyCloud/currencycloud-net</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- Build Settings                               -->
    <!-- ============================================ -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- Debug Configuration                          -->
    <!-- ============================================ -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <Optimize>false</Optimize>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
        <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- Release Configuration                        -->
    <!-- ============================================ -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <Optimize>true</Optimize>
        <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- NuGet Package Generation                     -->
    <!-- ============================================ -->
    <PropertyGroup>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <!-- ============================================ -->
    <!-- Package Dependencies (All Frameworks)        -->
    <!-- ============================================ -->
    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Polly" Version="7.2.4" />
    </ItemGroup>

    <!-- ============================================ -->
    <!-- .NET Standard 2.0 Dependencies               -->
    <!-- ============================================ -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    </ItemGroup>


</Project>
